# systemd-Unit für den Stock Signal Bot unter dem unprivilegierten User stockbot.
# Installation: sudo cp deploy/stockbot.service /etc/systemd/system/ && sudo systemctl daemon-reload
#
# Voraussetzung: Repo unter /opt/stockbot, venv angelegt; .env enthält nur Nicht-Secrets.
# Secrets liegen root-lesbar unter /etc/stockbot/credentials/. Alternativ kann bei transienten
# Units `SetCredential=NAME:WERT` verwendet werden. Rotation: Credential-Datei atomar ersetzen,
# dann `systemctl restart stockbot`; der Neustart liest alle Credentials erneut ein.
# Der Bot startet das Dashboard standardmäßig mit (RUN_DASHBOARD_IN_BOT=true) —
# ein separater dashboard.service ist dann NICHT nötig.

[Unit]
Description=Stock Signal Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stockbot
Group=stockbot
WorkingDirectory=/opt/stockbot
EnvironmentFile=/opt/stockbot/.env
# Nach dem Anlegen der jeweils benötigten Dateien aktivieren (fehlende Quellen sind fatal):
# LoadCredential=TELEGRAM_TOKEN_ENV:/etc/stockbot/credentials/telegram_token
# LoadCredential=ENCRYPTION_KEY:/etc/stockbot/credentials/encryption_key
# LoadCredential=POSTGRES_DSN:/etc/stockbot/credentials/postgres_dsn
# LoadCredential=ALPACA_API_KEY:/etc/stockbot/credentials/alpaca_api_key
# LoadCredential=ALPACA_API_SECRET:/etc/stockbot/credentials/alpaca_api_secret
# LoadCredential=ANTHROPIC_API_KEY:/etc/stockbot/credentials/anthropic_api_key
ExecStart=/opt/stockbot/venv/bin/python /opt/stockbot/run_bot.py
Restart=always
RestartSec=10

# Das Repo ist schreibgeschützt; nur Laufzeitdaten, Logs und der von systemd verwaltete
# yfinance-Cache sind beschreibbar. Netzwerk-Isolation ist wegen PostgreSQL auf localhost
# absichtlich nicht gesetzt. MemoryDenyWriteExecute entfällt wegen möglicher Python/JIT-Probleme.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/opt/stockbot/data /opt/stockbot/logs
CacheDirectory=stockbot
Environment=XDG_CACHE_HOME=/var/cache/stockbot

# yfinance leakt bei großen Scans (~500 Ticker) Datei-Handles auf seinen Timezone-Cache
# (~/.cache/py-yfinance/tkr-tz.db). Mit dem Default-Limit 1024 war nach ~1 Tag Dauerbetrieb
# kein sqlite3.connect mehr möglich ("unable to open database file", gesehen 2026-07-10).
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
