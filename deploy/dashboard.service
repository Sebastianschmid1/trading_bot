# systemd-Unit für das Web-Dashboard als EIGENER Dienst (optional).
# Nur nötig, wenn du das Dashboard getrennt vom Bot betreiben willst.
# Dann in der .env RUN_DASHBOARD_IN_BOT=false setzen (sonst Portkonflikt auf 8000).
#
# Installation: sudo cp deploy/dashboard.service /etc/systemd/system/ && sudo systemctl daemon-reload
#               sudo systemctl enable --now dashboard

[Unit]
Description=Stock Signal Bot — Web Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/trading_bot
EnvironmentFile=/root/trading_bot/.env
ExecStart=/root/trading_bot/venv/bin/python /root/trading_bot/dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
