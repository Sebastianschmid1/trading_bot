# Kopiere diese Datei auf dem Server nach .env (im Projekt-Root) und trage deine Werte ein.
# Wichtig: .env wird NICHT eingecheckt (steht in .gitignore) — Secrets bleiben geheim.
TELEGRAM_TOKEN_ENV=dein_token_hier

# Einmalig generieren mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (setup_server.sh erzeugt diesen Wert automatisch)
ENCRYPTION_KEY=generierten_schluessel_hier_einfuegen

# ── Dashboard ────────────────────────────────────────────────────────────────
# Öffentliche Adresse, unter der das Dashboard erreichbar ist (für den /dashboard-Link).
# Auf dem Server die Server-IP/Domain eintragen, sonst zeigt der Link auf localhost.
DASHBOARD_BASE_URL=http://DEINE-SERVER-IP:8000
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
# Dashboard im selben Prozess wie der Bot starten (true). Nur auf false setzen,
# wenn du den separaten dashboard.service nutzt.
RUN_DASHBOARD_IN_BOT=true
