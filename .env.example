# Kopiere diese Datei nach .env und trage deine echten Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore) — Secrets bleiben geheim.
TELEGRAM_TOKEN_ENV=dein_token_hier

# Einmalig generieren mit:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=generierten_schluessel_hier_einfuegen

# ── Dashboard ────────────────────────────────────────────────────────────────
# Wenn LEER gelassen, nutzt der Bot automatisch die LAN-IP dieses Rechners
# (Link funktioniert dann auch vom Handy im selben WLAN). Auf dem VPS:
# deine Domain/öffentliche IP eintragen, z. B. https://deine-domain.de
# DASHBOARD_BASE_URL=https://deine-domain.de
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Dashboard automatisch mit dem Bot starten (true). Auf dem VPS mit eigenem
# dashboard.service auf false setzen, um Doppelstart/Portkonflikt zu vermeiden.
RUN_DASHBOARD_IN_BOT=true

# ── Web-Sicherheit ───────────────────────────────────────────────────────────
# DOMAIN: Setzt du hier eine Domain (deren A-Record auf die Server-IP zeigt), richtet
# JEDER Deploy automatisch TLS via Caddy/Let's Encrypt ein (deploy/sync_caddy.sh):
# installiert Caddy bei Bedarf, schreibt /etc/caddy/Caddyfile, setzt unten
# DASHBOARD_BASE_URL/COOKIE_SECURE/HSTS_ENABLED passend und schließt Port 8000 nach außen.
# Leer lassen = kein TLS (Token-Login über http bleibt nutzbar).
# DOMAIN=bot.deine-domain.de
#
# Die folgenden drei Werte werden bei gesetzter DOMAIN automatisch gepflegt — manuell nur
# nötig, wenn du TLS anders (eigener Proxy) betreibst:
# Session-Cookie nur über HTTPS senden (Standard: auto-AN, sobald DASHBOARD_BASE_URL https ist).
# COOKIE_SECURE=true
# HSTS-Header (Strict-Transport-Security) senden — nur mit echtem TLS aktivieren.
# HSTS_ENABLED=true

# Optional: Bot-Benutzername (OHNE @) für den "Login mit Telegram"-Button auf der Website.
# Leer lassen → nur Login per privatem Dashboard-Token. DASHBOARD_BASE_URL muss dann auf
# die öffentliche https-Adresse zeigen (Telegram-Widget verlangt HTTPS).
# TELEGRAM_BOT_USERNAME=dein_bot

# ── KI-Signal-Ranking (optional, Claude Haiku) ───────────────────────────────
# Ohne Key bleibt das KI-Ranking einfach aus — der Bot läuft normal weiter.
# ANTHROPIC_API_KEY=sk-ant-...

# ── Deployment (für ./upload.sh) ─────────────────────────────────────────────
# Passphrase deines SSH-Keys (wird vom Upload-Script an sshpass übergeben).
# LOCAL_PASSWORD=deine_ssh_key_passphrase

# ── Broker: Alpaca (optional) ────────────────────────────────────────────────
# Empfohlen: Jeder Nutzer hinterlegt seine EIGENEN Keys direkt im Bot via
# /connectalpaca (verschlüsselt gespeichert) — dann werden die folgenden
# globalen Keys NICHT gebraucht. Die globalen Keys hier dienen nur als
# optionaler Fallback für alle Nutzer.
# PAPER=true = Demo-Konto (KEIN echtes Geld) — Standard. Die Order-Ausführung ist
# zusätzlich pro Nutzer in /settings standardmäßig AUS.
# ALPACA_API_KEY=dein_alpaca_key
# ALPACA_API_SECRET=dein_alpaca_secret
ALPACA_PAPER=true
# Erweiterte Handelszeiten (Pre-/After-Market) für Broker-Orders erlauben.
EXTENDED_HOURS=true
