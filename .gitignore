__pycache__/
*.pyc
venv/
.venv/
.env
logs/*.log
*.json
*.db
# Backtest-Reports (JSON) bewusst versionieren (Ausnahme von *.json)
!data/reports/
!data/reports/*.json
# Konversations-Exporte (persoenliche Transkript-Dumps) lokal lassen
docs/context_export*.md
docs/context_export*.json
_imported_transcripts/
*csv
# Strategie-Labor: Laufzeit-Zustand (state/pending/hypotheses) nicht versionieren
data/lab/
# Rohdatenarchiv (Parquet-Snapshots, Laufzeit-Cache) nicht versionieren
data/raw_archive/
# Polymarket-Rohdatenarchiv (JSON-Snapshots, Laufzeit-Cache) nicht versionieren (PM-0)
data/polymarket_archive/
# Build-Artefakt von `pip install -e .`
*.egg-info/
# Temporaere Git-Worktrees fuer isolierte Subagenten
.claude/worktrees/
# Test-Temp auf der Platte statt im RAM (/tmp ist tmpfs mit Quota)
.pytmp/
# Arbeitsverzeichnis des impeccable-Design-Werkzeugs (Screenshots, Cache)
.impeccable/
